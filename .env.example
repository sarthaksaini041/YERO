# ==============================================================================
# YERO Environment Variables Example
# Duplicate this file as .env for local development.
# In production (Vercel / Cloudflare / Netlify / VPS), configure these in your dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend Configuration
# Obtain from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# Public URL of your Supabase project instance (accessible from client and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key (safe to expose to client; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Web Push (VAPID) Keys
# Generate a new pair using: npx web-push generate-vapid-keys
# ------------------------------------------------------------------------------
# Public VAPID key used by the client browser to subscribe to push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Private VAPID key used ONLY on the server to sign Web Push payloads (NEVER EXPOSE)
VAPID_PRIVATE_KEY=your-vapid-private-key

# Contact email/URI associated with your VAPID keys (required by Web Push standard)
VAPID_SUBJECT=mailto:admin@yero.app

# ------------------------------------------------------------------------------
# 3. Scheduled Reminder Engine & Cron Security
# Generate using: openssl rand -hex 24
# ------------------------------------------------------------------------------
# Secret token required to trigger the reminder scheduler endpoint (/api/cron/reminders)
CRON_SECRET=your-random-cron-secret
